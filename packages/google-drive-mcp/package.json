{
  "name": "@packages/google-drive-mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "build",
    "package.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:types && pnpm run build:js",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "build:js": "node ../config/esbuild.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@packages/config": "workspace:*",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@packages/mcplib-core": "workspace:*",
    "@packages/mcp-core": "workspace:*",
    "@googleapis/drive": "latest",
    "@googleapis/driveactivity": "latest",
    "@googleapis/drivelabels": "latest",
    "zod": "4.6.5"
  }
}
