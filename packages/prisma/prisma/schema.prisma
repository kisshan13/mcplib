generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OAuthOwnershipType {
  PLATFORM
  ORGANIZATION
}

enum AuthenticationMethod {
  OAUTH
  API_KEY
  BEARER_TOKEN
  BASIC_AUTH
  CUSTOM
}

enum TokenOwnerType {
  PLATFORM_USER
  ORGANIZATION_USER
  ORGANIZATION_PROFILE
  EXTERNAL_IDENTITY
}

enum TokenStatus {
  ACTIVE
  EXPIRED
  REVOKED
  INVALID
}

enum OrganizationRole {
  OWNER
  ADMINISTRATOR
  MEMBER
}

enum McpConfigurationScope {
  PLATFORM
  ORGANIZATION
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  serviceTokens ServiceToken[]
  apiKeys       ApiKey[]
  organizationMemberships OrganizationMember[]

  @@map("user")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  oauthApplications OAuthApplication[]
  serviceTokens     ServiceToken[]
  mcpConfigurations McpConfiguration[]
  members           OrganizationMember[]
  apiKeys           ApiKey[]
  profiles          Profile[]

  @@map("organization")
}

model Profile {
  id             String   @id @default(cuid())
  organizationId  String
  name           String
  profilePicUrl   String?
  email          String?
  metadata       Json?
  providerId     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  apiKeys       ApiKey[]
  serviceTokens ServiceToken[]

  @@index([organizationId])
  @@unique([organizationId, providerId])
  @@map("profile")
}

model McpConfiguration {
  id             String                  @id @default(cuid())
  mcpId          String
  scope          McpConfigurationScope
  scopeKey       String
  organizationId String?
  values         Json
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([mcpId, scopeKey])
  @@index([mcpId, scope])
  @@index([organizationId])
  @@map("mcp_configuration")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_member")
}

model OAuthApplication {
  id                  String             @id @default(cuid())
  ownershipType       OAuthOwnershipType
  organizationId      String?
  integrationId       String
  serviceProvider     String
  clientId            String
  clientSecretEncrypted String?
  clientSecretReference String?
  scopes              String[]           @default([])
  providerConfig      Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceTokens ServiceToken[]

  @@unique([ownershipType, organizationId, integrationId, serviceProvider])
  @@index([organizationId])
  @@index([integrationId, serviceProvider])
  @@map("oauth_application")
}

model ServiceToken {
  id                    String             @id @default(cuid())
  secretId              String             @default(cuid())
  ownershipType         OAuthOwnershipType
  ownerType             TokenOwnerType
  organizationId        String?
  userId                String?
  profileId             String?
  externalUserIdentity  String?
  integrationId         String
  serviceProvider       String
  authenticationMethod  AuthenticationMethod
  oauthApplicationId    String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  credentialReference   String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  grantedScopes         String[]           @default([])
  status                TokenStatus        @default(ACTIVE)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile         Profile?          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  oauthApplication OAuthApplication? @relation(fields: [oauthApplicationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([profileId])
  @@index([integrationId, secretId])
  @@index([integrationId, serviceProvider])
  @@index([status])
  @@map("service_token")
}

model ApiKey {
  id             String             @id @default(cuid())
  name           String
  description    String?
  ownershipType  OAuthOwnershipType
  organizationId String?
  userId         String?
  profileId      String?
  prefix         String             @unique
  verifier       String
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile      Profile?          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  mcpAccess    ApiKeyMcpAccess[]

  @@index([ownershipType, organizationId])
  @@index([userId])
  @@index([profileId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("api_key")
}

model ApiKeyMcpAccess {
  id        String   @id @default(cuid())
  apiKeyId  String
  mcpId     String
  createdAt DateTime @default(now())

  apiKey ApiKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@unique([apiKeyId, mcpId])
  @@index([mcpId])
  @@map("api_key_mcp_access")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
