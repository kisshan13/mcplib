generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OAuthOwnershipType {
  PLATFORM
  ORGANIZATION
}

enum AuthenticationMethod {
  OAUTH
  API_KEY
  BEARER_TOKEN
  BASIC_AUTH
  CUSTOM
}

enum TokenOwnerType {
  PLATFORM_USER
  ORGANIZATION_USER
  EXTERNAL_IDENTITY
}

enum TokenStatus {
  ACTIVE
  EXPIRED
  REVOKED
  INVALID
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  serviceTokens ServiceToken[]

  @@map("user")
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  oauthApplications OAuthApplication[]
  serviceTokens     ServiceToken[]

  @@map("organization")
}

model OAuthApplication {
  id                  String             @id @default(cuid())
  ownershipType       OAuthOwnershipType
  organizationId      String?
  integrationId       String
  serviceProvider     String
  clientId            String
  clientSecretEncrypted String?
  clientSecretReference String?
  scopes              String[]           @default([])
  providerConfig      Json?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serviceTokens ServiceToken[]

  @@unique([ownershipType, organizationId, integrationId, serviceProvider])
  @@index([organizationId])
  @@index([integrationId, serviceProvider])
  @@map("oauth_application")
}

model ServiceToken {
  id                    String             @id @default(cuid())
  secretId              String             @unique @default(cuid())
  ownershipType         OAuthOwnershipType
  ownerType             TokenOwnerType
  organizationId        String?
  userId                String?
  externalUserIdentity  String?
  integrationId         String
  serviceProvider       String
  authenticationMethod  AuthenticationMethod
  oauthApplicationId    String?
  accessTokenEncrypted  String?
  refreshTokenEncrypted String?
  credentialReference   String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  grantedScopes         String[]           @default([])
  status                TokenStatus        @default(ACTIVE)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  organization     Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthApplication OAuthApplication? @relation(fields: [oauthApplicationId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([integrationId, serviceProvider])
  @@index([status])
  @@map("service_token")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
