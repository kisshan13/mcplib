{
  "name": "@packages/prisma",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "build",
    "package.json"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./build/index.js",
      "default": "./build/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "pnpm run generate && pnpm run build:types && pnpm run build:js",
    "build:types": "tsc -p tsconfig.json --emitDeclarationOnly",
    "build:js": "node ../config/esbuild.config.mjs",
    "typecheck": "pnpm run generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@packages/config": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "prisma": "^7.0.0"
  }
}
